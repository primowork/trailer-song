# העתק ל-`.streamlit/secrets.toml` (שאינו נכנס ל-git) כדי להפעיל התחברות.
#
# **בלי הקובץ הזה האפליקציה עובדת בדיוק כמו קודם**: משתמש יחיד, בלי
# מכסה, בלי חסימת שמירה. זו הסיבה שהטסטים והפיתוח המקומי לא נשברו
# מעצם קיום ההתחברות — `accounts.login_available()` פשוט מחזיר False.
#
# Google בלבד, כפי שהוחלט. את ה-client_id/secret מייצרים ב-Google Cloud
# Console -> APIs & Services -> Credentials -> OAuth client ID (Web),
# ומוסיפים שם את אותה כתובת בדיוק שמופיעה כאן ב-redirect_uri.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# מחרוזת אקראית וארוכה. `python -c "import secrets; print(secrets.token_hex(32))"`
cookie_secret = "החלף-אותי"

[auth.google]
client_id = "...apps.googleusercontent.com"
client_secret = "..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
